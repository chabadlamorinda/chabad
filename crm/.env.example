# Copy to .env (or set these in Render → Environment).

# Required
ANTHROPIC_API_KEY=sk-ant-...          # Claude: understands texts and photos, updates the CRM
ADMIN_PASSWORD=choose-a-strong-one    # dashboard login
SESSION_SECRET=long-random-string     # signs the login cookie
PUBLIC_URL=https://your-app.onrender.com

# Voice notes (Claude reads text and photos; voice notes are transcribed first)
OPENAI_API_KEY=sk-...

# Telegram (recommended: free, handles text + voice notes + photos)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USER_IDS=123456789   # comma-separated; the bot tells you your id

# WhatsApp / SMS through Twilio (optional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
ALLOWED_PHONE_NUMBERS=+19255551234    # comma-separated, E.164

# Optional
DATA_DIR=./data                       # where the database and uploaded photos/voice notes live
TIME_ZONE=America/Los_Angeles
CLAUDE_MODEL=claude-opus-5-5
