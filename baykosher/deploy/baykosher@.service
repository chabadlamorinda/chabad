[Unit]
Description=Bay Kosher (%i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=baykosher
WorkingDirectory=/opt/baykosher/%i/baykosher
EnvironmentFile=/etc/baykosher/%i.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
