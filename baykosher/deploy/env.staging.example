# /etc/baykosher/staging.env  (chmod 600). The test copy of the store: fake payments, nothing is ever sent
# to customers, Clover/Uber/Gmail are NOT connected. Do not add real service keys here.
NODE_ENV=staging
ALLOW_FAKE_PAYMENTS=1
PORT=3001
DATABASE_URL=postgres://baykosher:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/baykosher_staging
PUBLIC_URL=https://staging.baykosher.com
SESSION_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_CHARS
ADMIN_PASSWORD=CHANGE_ME_12_PLUS_CHARS
PICKER_PIN=1234
# ANTHROPIC_API_KEY may be added to test the invoice reader (costs a little per invoice).
