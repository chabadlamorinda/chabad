# /etc/baykosher/prod.env  (chmod 600, owner root). Copy from this file; never commit the real one.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://baykosher:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/baykosher
# While testing, use the test address and keep NOINDEX=1 so Google ignores it.
# At launch: PUBLIC_URL=https://baykosher.com and delete the NOINDEX line.
PUBLIC_URL=https://shop-test.chabadoflamorinda.com
NOINDEX=1
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
ADMIN_PASSWORD=CHANGE_ME_12_PLUS_CHARS
PICKER_PIN=CHANGE_ME

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Bay Kosher <orders@baykosher.com>
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CLOVER_MERCHANT_ID=
CLOVER_TOKEN=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
GOOGLE_MAPS_KEY=

# Supplier invoices
ANTHROPIC_API_KEY=
# INBOXES=[{"user":"baykosher@gmail.com","pass":"gmail-app-password"}]

# Backups (see deploy/README.md). rclone remote name:path, e.g. gdrive:BayKosherBackups
BACKUP_REMOTE=
# Optional dead-man's-switch URL (healthchecks.io): pinged after every good backup, so you hear about silence
BACKUP_PING_URL=
