# Copy these into your hosting service's "Environment" settings (Render), or into a file named .env if running on your own computer.
# NEVER put real values in a file you share or upload to GitHub.

SESSION_SECRET=make-this-a-long-random-string-at-least-16-characters
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
ADMIN_PASSWORD=choose-a-password-of-12-or-more-characters

# Card payments (optional; start with the sk_test_/pk_test_ keys, switch both to live when ready)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Automatic payment-reminder emails (optional)
SMTP_URL=
MAIL_FROM=
