# Copy these into Render -> your service -> Environment. NEVER commit real values or paste them into a chat.
SESSION_SECRET=            # created automatically by Render (render.yaml); locally use any 16+ characters
STRIPE_PUBLISHABLE_KEY=    # pk_test_... first, then pk_live_...
STRIPE_SECRET_KEY=         # sk_test_... first, then sk_live_...
STRIPE_WEBHOOK_SECRET=     # whsec_... (Stripe -> Developers -> Webhooks)
DATABASE_URL=              # optional: postgres://... from neon.com (yahrzeits, staff page, announcements)
ADMIN_PASSWORD=            # optional: 12+ characters, opens /admin/
VAPID_PUBLIC_KEY=          # optional: reminders on closed apps (npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
APPLE_PAY_ASSOC=           # optional: text of the Apple Pay domain file from Stripe
BOARD_FRAME_ANCESTORS=     # optional: websites allowed to embed the honor board (space separated, https://...)
ANDROID_PACKAGE=           # optional, Google Play
ANDROID_SHA256=            # optional, Google Play app-signing fingerprint(s)
